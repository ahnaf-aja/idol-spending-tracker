# ---------------------------------------------------------------------------
# Idol Spending Tracker - environment variables
#
# Copy this file to .env and fill in real values.
# NEVER commit real credentials, and never put any of these behind
# NEXT_PUBLIC_ (that prefix ships the value to the browser).
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
#
# Local development only. `next dev` and `next build` both load .env.local,
# which OVERRIDES this file - so never park a production URL there. Production
# URLs belong in .env.production.local (read only for production builds).
# tests/env-isolation.test.ts enforces this split.
DATABASE_URL=

# Initial owner account created by `npm run seed`
SEED_USERNAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# App URL, used to build password reset links (no trailing slash)
APP_URL=http://localhost:3000
NODE_ENV=development

# Password reset token lifetime in minutes (15-30 recommended)
RESET_TOKEN_TTL_MINUTES=20

# ---------------------------------------------------------------------------
# Optional SMTP. Leave empty to use the local dev outbox: reset links are
# written to <project>/.dev-outbox/ and printed in the server console.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_URL=
MAIL_FROM=
